[Unit]
Description=Datagram Node Instance %i
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
EnvironmentFile=/etc/datagram/instances/%i.conf
ExecStart=/usr/local/bin/datagram run -- -key ${LICENSE_KEY}
Restart=always
RestartSec=10
StandardOutput=journal
StandardError=journal

# Security settings
NoNewPrivileges=false
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/datagram

# Capabilities required for WireGuard
AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_MODULE
CapabilityBoundingSet=CAP_NET_ADMIN CAP_NET_RAW CAP_SYS_MODULE

# Resource limits
LimitNOFILE=8192

[Install]
WantedBy=multi-user.target
