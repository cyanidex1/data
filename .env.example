# Control Plane Configuration
SECRET_KEY=change-this-to-a-random-secret-key
DEBUG=False

# Admin Credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password

# Agent API Keys (comma-separated)
# Generate keys with: python -c "import secrets; print(secrets.token_hex(32))"
AGENT_API_KEYS=agent-key-1,agent-key-2

# WebSocket Configuration
SOCKETIO_ASYNC_MODE=eventlet

# Data Directory
DATA_DIR=/data

# Agent Configuration (for agent deployment)
CONTROL_PLANE_URL=http://localhost:5000
AGENT_API_KEY=change-this-api-key
HOST_ID=agent-host-1
# Platform architecture: linux/amd64 (x86_64) or linux/arm64 (ARM)
PLATFORM=linux/amd64
